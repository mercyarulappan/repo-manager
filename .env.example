# From https://github.com/settings/developers -> OAuth Apps -> New OAuth App
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret

# Any long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me

# Public URL of this site (no trailing slash)
BASE_URL=http://localhost:3000
PORT=3000
